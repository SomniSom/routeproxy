#compdef rpctl
# zsh completion for rpctl — generated by rpctl completion zsh
# Usage: eval "$(rpctl completion zsh)"
#    or: fpath+=(".../contrib/completions") && compinit

_rpctl() {
  local -a commands
  commands=(
    "generate:YAML → sing-box JSON (mixed SOCKS)"
    "generate-sfa:YAML → SFA JSON (TUN / Android VPN)"
    "check:generate + sing-box check"
    "apply:generate, check, restart via apply.commands"
    "add:import vless://, tg://socks, t.me/proxy"
    "telegram-urls:print MTProto links + local SOCKS"
    "why:explain outbound for a host"
    "probe:healthz + mixed smoke"
    "checker:MTProto TCP failover (:1443+)"
    "completion:print bash or zsh completion script"
    "help:show this help"
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'rpctl command' commands
    return
  fi
  case ${words[2]} in
    generate)
      _arguments \
        '-config[yaml config (or $ROUTEPROXY_CONFIG)]:PATH:_files'
      ;;
    generate-sfa)
      _arguments \
        '-config[yaml config (or $ROUTEPROXY_CONFIG)]:PATH:_files' \
        '-out[output JSON (`-` for stdout)]:PATH:_files'
      ;;
    check)
      _arguments \
        '-config[yaml config (or $ROUTEPROXY_CONFIG)]:PATH:_files'
      ;;
    apply)
      _arguments \
        '-config[yaml config (or $ROUTEPROXY_CONFIG)]:PATH:_files'
      ;;
    add)
      _arguments -S \
        '-config[yaml config (or $ROUTEPROXY_CONFIG)]:PATH:_files' \
        '-purpose[comma purposes (default auto,telegram)]:LIST:' \
        '-name[optional proxy name]:NAME:' \
        '1:url:'
      ;;
    telegram-urls)
      _arguments \
        '-config[yaml config (or $ROUTEPROXY_CONFIG)]:PATH:_files'
      ;;
    why)
      _arguments -S \
        '-config[yaml config (or $ROUTEPROXY_CONFIG)]:PATH:_files' \
        '1:host:'
      ;;
    probe)
      _arguments \
        '-config[yaml config (or $ROUTEPROXY_CONFIG)]:PATH:_files'
      ;;
    checker)
      _arguments \
        '-config[yaml config (or $ROUTEPROXY_CONFIG)]:PATH:_files'
      ;;
    completion)
      local -a shells
      shells=(
        "bash:Bash completion on stdout"
        "zsh:Zsh completion on stdout"
      )
      if (( CURRENT == 3 )); then
        _describe -t shells 'shell' shells
        return
      fi
      ;;
  esac
}

_rpctl
